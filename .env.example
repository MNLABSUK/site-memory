# Nebius Token Factory (OpenAI-compatible). Leave the key blank for a dry-run demo.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Door-step tasks: capture, arrival brief, skills
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Nightly route pass (bigger Nemotron)
NEBIUS_NIGHTLY_MODEL=nvidia/nemotron-3-super-120b-a12b
# Apprentice Skills: learn / improve (defaults to the nightly model)
NEBIUS_SKILLS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Local time for the automatic nightly pass, or "off"
SITE_MEMORY_NIGHTLY_AT=20:30
# SITE_MEMORY_PORT=43167
# Optional: Tavily web search for "Find manual + firmware" on an asset (sends make/model only)
TAVILY_API_KEY=
# Public-demo guard rails (rate limits + scheduled reset). Leave off for your own install.
# SITE_MEMORY_DEMO=1
# SITE_MEMORY_DEMO_RESET_MIN=30
# Seconds before a slow Nemotron call falls back to local heuristics
# SITE_MEMORY_LLM_TIMEOUT=55
